# ---------------------------------------------------------------- Rust build
/target
**/*.rs.bk
*.pdb

# `Cargo.lock` is deliberately NOT ignored: this workspace ships a binary
# (`tokenpress-cli`), and a committed lockfile is what makes a build
# reproducible for anyone installing from git.

# ------------------------------------------------------------------ Coverage
# `cargo llvm-cov` writes under `target/`, but its raw profiles can land in the
# working directory depending on how it is invoked.
*.profraw
*.profdata
lcov.info
/coverage/

# ------------------------------------- Downloaded and generated by this repo
# The benchmark corpora are clones of other people's repositories and the
# tokenizer files are third-party downloads; neither is ours to redistribute,
# and both are reproducible with `benchmarks/fetch.{sh,ps1}`.
/benchmarks/corpus/
/benchmarks/tokenizers/

# The wasm demo's build output and the toolchain it fetches to produce it.
/site/pkg/
/site/.tools/

# Local-only working notes: design docs, decision log, promo drafts, and the
# archived internal roadmap. Not part of the published project.
/notes/
/LOOPLOG.md

# ----------------------------------------------------- Secrets and local env
# Nothing here should ever be committed. `benchmarks/fetch.sh` can take an
# `HF_TOKEN` for gated tokenizer repositories, and a token belongs in the
# environment, never in the tree.
.env
.env.*
!.env.example
.envrc
*.pem
*.key
*.p12
*.pfx
id_rsa*
.netrc
.huggingface/
hf_token

# ---------------------------------------------------------- Editors and IDEs
.vscode/
.idea/
*.iml
.fleet/
.zed/
*.swp
*.swo
*~
.sublime-project
.sublime-workspace
# Machine-local Claude Code state. `CLAUDE.md` itself is tracked.
.claude/settings.local.json
.claude/worktrees/

# -------------------------------------------------------------------- Python
# Not a Python project, but `benchmarks/quality-eval` and the corpora bring
# Python tooling into the tree.
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# ---------------------------------------------------------------- JavaScript
# `site/` is plain files with no build step, but a stray `npm` run should not
# be committable.
node_modules/
npm-debug.log*
yarn-error.log*
.pnpm-debug.log*

# -------------------------------------------------------- Operating systems
# macOS
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
# Windows
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/
# Linux
.fuse_hidden*
.directory

# ----------------------------------------------------------- Logs and scratch
*.log
/tmp/
*.tmp
*.bak
*.orig
*.rej
